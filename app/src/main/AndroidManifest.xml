<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme._113_4B_25092025"
        tools:targetApi="31">
        
        <!-- Pantalla de Carga (Splash) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Login -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Pantalla de Registro de Cuenta -->
        <activity
            android:name=".RegistrarCuentaActivity"
            android:exported="false" />

        <!-- Pantalla de Recuperar Contraseña -->
        <activity
            android:name=".RecuperarContraActivity"
            android:exported="false" />

        <!-- ============================================= -->
        <!--    ACTIVITIES DE NOTICIAS AÑADIDAS AQUÍ     -->
        <!-- ============================================= -->

        <!-- Pantalla Principal (Listado de Noticias) -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- Pantalla para Agregar una Noticia -->
        <activity
            android:name=".AgregarNoticiaActivity"
            android:exported="false" />

        <!-- Pantalla para Ver el Detalle de una Noticia -->
        <activity
            android:name=".VerNoticiaActivity"
            android:exported="false" />
            
    </application>
</manifest>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/fondoApp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo"
        android:alpha="0.9" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@color/purple"
        android:contentDescription="Settings"
        android:padding="16dp"
        android:src="@android:drawable/ic_menu_manage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="@id/fondoApp"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="0dp">

        <ImageView
            android:id="@+id/imagenLogo"
            android:layout_width="260dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:layout_marginBottom="50dp"
            android:src="@drawable/logo_2" />

        <TextView
            android:id="@+id/textoBienvenida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="30dp"
            android:text="Bienvenido a Tu Aplicacion"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="370dp"
            android:layout_height="331dp"
            app:cardCornerRadius="15dp"
            app:cardElevation="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="15dp"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteX="0dp"
                tools:layout_editor_absoluteY="-20dp">

                <View
                    android:layout_width="340dp"
                    android:layout_height="23dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/textoSesion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Iniciar sesión"
                        android:textColor="@color/black"
                        android:textSize="17sp" />


                </LinearLayout>

                <EditText
                    android:id="@+id/inputCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill"
                    android:ems="10"
                    android:hint="Ingrese su correo"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/inputPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="10dp"
                    android:ems="10"
                    android:hint="Ingrese contraseña"
                    android:inputType="textPassword" />

                <CheckBox
                    android:id="@+id/checkHoldSession"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginBottom="15dp"
                    android:text="Mantener la sesión iniciada" />

                <Button
                    android:id="@+id/botonPrincipal"
                    android:layout_width="145dp"
                    android:layout_height="37dp"
                    android:layout_gravity="top|end"
                    android:backgroundTint="@color/purple"
                    android:text="Iniciar sesión" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:orientation="horizontal">


                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="match_parent">

                    </FrameLayout>

                    <Button
                        android:id="@+id/linkRegistrar"
                        android:layout_width="wrap_content"
                        android:layout_height="35dp"
                        android:backgroundTint="@color/purple"
                        android:text="Registrarse"
                        android:textColor="@color/white"
                        android:textSize="11dp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="24dp"
                        android:layout_height="18dp">

                    </FrameLayout>

                    <Button
                        android:id="@+id/linkRecuperar"
                        android:layout_width="wrap_content"
                        android:layout_height="37dp"
                        android:backgroundTint="@color/purple"
                        android:text="Olvidaste tu contraseña?"
                        android:textColor="@color/white"
                        android:textSize="11dp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:layout_width="53dp"
                android:layout_height="46dp"
                android:layout_gravity="top|end"
                app:srcCompat="@drawable/oip" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
